# ============================================================

# 忽略根目录下所有内容
/*

# 放行所有子项目
!/backend/
!/miniapp/
!/test/
!/webapp/

# 放行根目录 README
!/README.md

# ============================================================
# 以下规则仅对已追踪目录生效
# ============================================================

# Dependencies
node_modules/
vendor/
miniprogram_npm/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Build output
dist/
build/
target/
bin/

# Logs
*.log
logs/
npm-debug.log*

# Temp
tmp/
temp/
*.tmp

# Coverage
coverage/
*.coverprofile

# Certificates
*.pem
*.key
*.crt

