.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12rpx 21rpx 21rpx 21rpx;
  padding-bottom: calc(21rpx + env(safe-area-inset-bottom));
  background-color: var(--color-bg-page);
}

.tab-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 62rpx;
  padding: 4rpx;
  gap: 2rpx;
  background-color: #FFFFFF;
  border-radius: 36rpx;
  border: 1rpx solid var(--color-divider);
}

.tab-item {
  flex: 1;
  height: 100%;
  border-radius: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  transition: all 0.2s;
}

.tab-item--active {
  background-color: var(--color-primary);
}

.tab-icon {
  font-size: 16rpx;
  line-height: 1;
  color: var(--color-text-hint);
}

.tab-icon--active {
  color: var(--color-text-on-primary);
}

.tab-label {
  font-size: 10rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--color-text-hint);
}

.tab-label--active {
  color: var(--color-text-on-primary);
}
