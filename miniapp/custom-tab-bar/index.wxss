.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  padding: 12rpx 16rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  background-color: transparent;
  pointer-events: none;
}

.tab-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 124rpx;
  padding: 8rpx;
  gap: 4rpx;
  background-color: #FFFFFF;
  border-radius: 72rpx;
  border: 2rpx solid var(--color-divider);
  box-sizing: border-box;
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  height: 100%;
  border-radius: 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  transition: all 0.2s;
}

.tab-item--active {
  background-color: var(--color-primary);
}

.tab-item:active {
  transform: scale(0.92);
}

.tab-icon {
  font-size: 28rpx;
  line-height: 1;
  color: var(--color-text-hint);
  transition: color 0.2s;
}

.tab-icon--active {
  color: var(--color-text-on-primary);
}

.tab-label {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--color-text-hint);
  transition: color 0.2s;
}

.tab-label--active {
  color: var(--color-text-on-primary);
}
