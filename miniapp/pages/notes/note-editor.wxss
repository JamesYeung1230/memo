.form-wrap {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  color: var(--color-text-primary);
  font-size: var(--font-body);
  font-weight: 600;
}

.form-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
  color: var(--color-text-primary);
  font-size: var(--font-body);
  border: 2rpx solid transparent;
}

.form-input--error {
  border-color: var(--color-error);
}

.form-placeholder {
  color: var(--color-text-hint);
  font-size: var(--font-body);
}

.form-item--content {
  flex: 1;
}

.form-textarea {
  width: 100%;
  min-height: 300rpx;
  padding: 24rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
  color: var(--color-text-primary);
  font-size: var(--font-body);
  line-height: 1.6;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.form-textarea--error {
  border-color: var(--color-error);
}

.form-submit {
  padding: 16rpx 0 48rpx 0;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-primary);
}

.submit-btn--disabled {
  opacity: 0.6;
}

.submit-btn-text {
  color: var(--color-text-on-primary);
  font-size: var(--font-body);
  font-weight: 600;
}
