<view class="page-wrapper {{_pageEnter ? 'page-enter' : ''}}" style="padding-top: {{statusBarHeight}}px">
  <view class="nav-bar">
    <text class="nav-title">我的笔记</text>
    <text class="nav-add" bind:tap="onAddNote">+</text>
  </view>

  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索笔记..." placeholder-class="search-placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" />
  </view>

  <view class="filter-tabs">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="filter-item {{activeFilter === item.key ? 'filter-item--active' : ''}}"
      data-key="{{item.key}}"
      bind:tap="onFilterTap"
    >
      <text class="filter-text {{activeFilter === item.key ? 'filter-text--active' : ''}}">{{item.label}}</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading && notes.length === 0}}" class="loading-wrap">
    <loading-spinner></loading-spinner>
  </view>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{showEmpty && !loading}}"
    icon="📝"
    message="暂无笔记，点击右上角 + 新建"
  ></empty-state>

  <!-- 笔记列表 -->
  <scroll-view
    wx:elif="{{notes.length > 0}}"
    class="note-scroll"
    scroll-y
    type="list"
    bindscrolltolower="onReachBottom"
  >
    <view class="content-scroll">
      <view
        wx:for="{{notes}}"
        wx:key="index"
        class="note-item"
        data-note-id="{{item.note_id}}"
        bind:tap="onNoteTap"
      >
        <view class="note-content">
          <text class="note-title">{{item.title}}</text>
          <text class="note-preview">{{item.preview}}</text>
          <view class="note-meta">
            <text class="note-time">{{item.time}}</text>
            <view class="note-status note-status--{{item.statusClass}}">
              <text class="note-status-text">{{item.statusLabel}}</text>
            </view>
          </view>
        </view>
        <text class="note-arrow">›</text>
      </view>

      <!-- 加载更多 -->
        <view wx:if="{{loadingMore}}" class="load-more-wrap">
          <loading-spinner></loading-spinner>
        </view>
        <view class="bottom-safe-area" />
      </view>
    </scroll-view>
  </view>
