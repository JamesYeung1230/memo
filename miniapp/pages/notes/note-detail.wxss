.page-scroll {
  flex: 1;
  height: 100vh;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.detail-wrap {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx;
}

.detail-title {
  color: var(--color-text-primary);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
}

.detail-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.detail-status {
  border-radius: var(--radius-sm);
  padding: 4rpx 16rpx;
}

.detail-status--draft {
  background-color: #F3F4F6;
}

.detail-status--pending {
  background-color: #FEF3C7;
}

.detail-status--approved {
  background-color: #DCFCE7;
}

.detail-status--rejected {
  background-color: #FEE2E2;
}

.detail-status-text {
  font-size: var(--font-tag);
}

.detail-status--draft .detail-status-text {
  color: var(--color-text-hint);
}

.detail-status--pending .detail-status-text {
  color: var(--color-warning);
}

.detail-status--approved .detail-status-text {
  color: var(--color-success);
}

.detail-status--rejected .detail-status-text {
  color: var(--color-error);
}

.detail-time {
  color: var(--color-text-hint);
  font-size: var(--font-caption);
}

.detail-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.detail-content {
  padding: 24rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
}

.detail-content-text {
  color: var(--color-text-primary);
  font-size: var(--font-body);
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail-card-link {
  padding: 16rpx 24rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-bg-card);
}

.detail-card-label {
  color: var(--color-primary);
  font-size: var(--font-caption);
}

.detail-audit-remark {
  padding: 16rpx 24rpx;
  border-radius: var(--radius-md);
  background-color: #FEF3C7;
}

.detail-remark-label {
  color: var(--color-warning);
  font-size: var(--font-caption);
  font-weight: 600;
}

.detail-remark-text {
  color: var(--color-text-primary);
  font-size: var(--font-caption);
  margin-left: 8rpx;
}

.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 0 48rpx 0;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-lg);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-card);
}

.action-btn-text {
  color: var(--color-text-primary);
  font-size: var(--font-body);
  font-weight: 600;
}

.action-btn--edit {
  border-color: var(--color-primary);
  background-color: var(--color-primary);
}

.action-btn--edit .action-btn-text {
  color: var(--color-text-on-primary);
}

.action-btn--submit {
  border-color: var(--color-primary);
}

.action-btn--submit .action-btn-text {
  color: var(--color-primary);
}

.action-btn--withdraw {
  border-color: var(--color-warning);
}

.action-btn--withdraw .action-btn-text {
  color: var(--color-warning);
}

.action-btn--share {
  border-color: var(--color-primary);
}

.action-btn--share .action-btn-text {
  color: var(--color-primary);
}

.action-btn--delete .action-btn-text {
  color: var(--color-error);
}
