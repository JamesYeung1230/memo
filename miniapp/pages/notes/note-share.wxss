.page-scroll {
  flex: 1;
  height: 100vh;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}

.share-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  padding: 48rpx 32rpx;
}

.share-card {
  width: 100%;
  max-width: 560rpx;
  padding: 40rpx;
  border-radius: var(--radius-xl);
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
}

.share-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.share-card-icon {
  font-size: 40rpx;
}

.share-card-badge {
  color: rgba(255, 255, 255, 0.8);
  font-size: var(--font-tag);
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.share-card-title {
  display: block;
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.share-card-preview {
  display: block;
  color: rgba(255, 255, 255, 0.85);
  font-size: var(--font-body);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.share-card-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.share-card-footer {
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
  padding-top: 24rpx;
}

.share-card-footer-text {
  color: rgba(255, 255, 255, 0.6);
  font-size: var(--font-caption);
}

.share-hint {
  text-align: center;
  padding: 0 32rpx;
}

.share-hint-text {
  color: var(--color-text-hint);
  font-size: var(--font-caption);
  line-height: 1.5;
}

.share-save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 560rpx;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-primary);
}

.share-save-btn-text {
  color: var(--color-text-on-primary);
  font-size: var(--font-body);
  font-weight: 600;
}
