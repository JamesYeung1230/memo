.page-scroll {
  flex: 1;
  height: 100vh;
}

.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 96rpx;
  gap: 40rpx;
}

.logo-box {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background-color: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-text {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 700;
}

.app-title {
  color: var(--color-text-primary);
  font-size: 36rpx;
  font-weight: 700;
}

.subtitle {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}

.btn-wrapper {
  width: 100%;
}

.btn-wrapper .btn.btn--lg {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
}

.privacy-text {
  color: var(--color-text-hint);
  font-size: var(--font-caption);
}

.privacy-checkbox {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 40rpx;
  flex-wrap: wrap;
}

.checkbox-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 3rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s;
  background-color: #FFFFFF;
}

.checkbox-box:active {
  border-color: var(--color-primary);
  background-color: var(--color-primary-light);
  transform: scale(0.92);
}

.checkbox-checked {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  box-shadow: 0 2rpx 8rpx var(--color-primary);
}

.checkbox-icon {
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
}

.privacy-label {
  color: var(--color-text-hint);
  font-size: var(--font-caption);
}

.privacy-link {
  color: var(--color-primary);
  font-size: var(--font-caption);
  text-decoration: underline;
}