.page-scroll {
  flex: 1;
  height: 100vh;
}

.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 0 96rpx;
  gap: 40rpx;
}

.logo-box {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background-color: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-text {
  color: #FFFFFF;
  font-size: 48rpx;
  font-weight: 700;
}

.app-title {
  color: var(--color-text-primary);
  font-size: 36rpx;
  font-weight: 700;
}

.subtitle {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}

.btn-wrapper {
  width: 480rpx;
}

.btn-wrapper .btn.btn--lg {
  width: 480rpx;
  height: 96rpx;
  border-radius: 48rpx;
}

/* 或 分割线 */
.guest-divider {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 480rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background-color: var(--color-border);
}

.divider-text {
  color: var(--color-text-hint);
  font-size: var(--font-caption);
  white-space: nowrap;
}

/* 游客模式按钮 — 与登录按钮同尺寸，次要样式 */
.guest-btn {
  width: 480rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg-card);
  border: 2rpx solid var(--color-primary);
  box-sizing: border-box;
}

.guest-btn:active {
  opacity: 0.7;
}

.guest-btn-text {
  color: var(--color-primary);
  font-size: 34rpx;
  font-weight: 600;
}

.privacy-text {
  color: var(--color-text-hint);
  font-size: var(--font-caption);
}

.privacy-checkbox {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 40rpx;
  flex-wrap: wrap;
}

.checkbox-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  border: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox-checked {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.checkbox-icon {
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
}

.privacy-label {
  color: var(--color-text-hint);
  font-size: var(--font-caption);
}

.privacy-link {
  color: var(--color-primary);
  font-size: var(--font-caption);
  text-decoration: underline;
}