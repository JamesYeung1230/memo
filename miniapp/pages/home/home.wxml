<view class="page-wrapper {{_pageEnter ? 'page-enter' : ''}}">
  <view class="nav-bar">
    <text class="nav-title">{{navTitle}}</text>
  </view>

  <!-- 游客登录提示 -->
  <view wx:if="{{_isGuest}}" class="guest-login-bar" bind:tap="onGuestLoginTap">
    <view class="guest-login-content">
      <text class="guest-login-icon">👤</text>
      <view class="guest-login-info">
        <text class="guest-login-title">登录后同步学习数据</text>
        <text class="guest-login-sub">一键微信登录，云端保存进度</text>
      </view>
      <view class="guest-login-btn">
        <text class="guest-login-btn-text">登录</text>
      </view>
    </view>
  </view>

  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="content-scroll">
      <view class="banner" bind:tap="onBannerTap">
        <text class="banner-text">{{bannerText}}</text>
      </view>

      <view class="progress-card">
        <view class="progress-ring">
          <view class="progress-ring-inner">
            <text class="progress-percent">{{ringPercent}}</text>
          </view>
        </view>
        <view class="progress-stats">
          <text class="stat-line-1">{{statLine1}}</text>
          <text class="stat-line-2">{{statLine2}}</text>
        </view>
      </view>

      <view class="review-card" bind:tap="onReviewTap">
        <view class="review-left">
          <text>📋</text>
          <view class="review-info">
            <text class="review-label">{{reviewTitle}}</text>
            <text style="color: var(--color-warning); font-size: var(--font-caption);">{{reviewSub}}</text>
          </view>
        </view>
        <view class="review-badge">
          <text class="review-badge-num">{{reviewBadgeNum}}</text>
        </view>
      </view>

      <view class="section-label">{{sectionLabel}}</view>

      <view class="knowledge-card">
        <view class="card-header">
          <view class="card-tag">
            <text class="card-tag-text">{{cardTagText}}</text>
          </view>
          <text class="card-bookmark">🔖</text>
        </view>
        <text class="card-title">{{cardTitle}}</text>
        <text class="card-concept">{{cardConcept}}</text>
        <text class="card-desc">{{cardDesc}}</text>
        <view class="card-actions">
          <view class="card-btn-primary" bind:tap="onCardGotIt">
            <text class="card-btn-primary-text">{{gotItText}}</text>
          </view>
          <view class="card-btn-save" bind:tap="onCardSave">
            <text class="card-btn-save-text">{{saveText}}</text>
          </view>
        </view>
      </view>

      <view class="challenge-card">
        <view class="challenge-left">
          <text>🎯</text>
          <view class="challenge-info">
            <text class="challenge-title">{{challengeTitle}}</text>
            <text style="color: var(--color-success); font-size: var(--font-caption);">{{challengeSub}}</text>
          </view>
        </view>
        <view class="challenge-btn" bind:tap="onChallengeStart">
          <text class="challenge-btn-text">{{challengeBtnText}}</text>
        </view>
      </view>

      <view class="notes-card" bind:tap="onQuickNote">
        <view class="notes-left">
          <text class="notes-emoji">✏️</text>
          <text class="notes-text">{{notesPlaceholder}}</text>
        </view>
        <view class="notes-add">
          <text class="notes-add-text">+</text>
        </view>
      </view>

      <view class="points-card">
        <view class="points-left">
          <text class="points-emoji">{{pointsEmoji}}</text>
          <text class="points-amount">{{pointsAmount}}</text>
        </view>
        <view class="points-ad-btn" bind:tap="onWatchAd">
          <text class="points-ad-text">{{pointsAdText}}</text>
        </view>
      </view>
      <view class="bottom-safe-area" />
    </view>
  </scroll-view>
</view>