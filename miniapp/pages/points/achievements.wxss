.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--color-bg-page);
}

.balance-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 32rpx;
}

.balance-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.balance-amount {
  font-size: 36rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-text {
  color: var(--color-text-hint);
  font-size: var(--font-body);
}

.badge-scroll {
  flex: 1;
  height: 0;
}

.badge-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 32rpx 32rpx 32rpx;
}

.badge-item {
  width: calc(50% - 8rpx);
}

.badge-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx 24rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
}

.badge-card--locked {
  opacity: 0.6;
}

.badge-icon {
  font-size: 72rpx;
}

.badge-name {
  font-size: 28rpx;
  color: var(--color-text-primary);
  font-weight: 600;
}

.badge-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.badge-text--muted {
  color: var(--color-text-hint);
}

.badge-status {
  margin-top: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-bg-page);
}

.badge-status--earned {
  background-color: var(--color-primary);
}

.badge-status-text {
  font-size: 22rpx;
  color: var(--color-text-hint);
}

.badge-status-text--earned {
  color: var(--color-text-on-primary);
  font-weight: 600;
}
