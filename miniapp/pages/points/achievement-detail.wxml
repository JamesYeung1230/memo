<nav-bar mode="back" title="徽章详情">

<view class="page-wrapper">
  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{_loading}}">
    <loading-component></loading-component>
  </view>

  <!-- 徽章详情 -->
  <view class="detail-wrap" wx:elif="{{badge}}">
    <view class="badge-hero">
      <view class="badge-icon-wrap {{badge.unlocked ? '' : 'badge-icon-wrap--locked'}}">
        <text class="badge-hero-icon">{{badge.iconUrl}}</text>
      </view>
      <text class="badge-hero-name">{{badge.name}}</text>
      <view class="badge-hero-status {{badge.unlocked ? 'badge-hero-status--earned' : 'badge-hero-status--locked'}}">
        <text class="badge-hero-status-text">{{badge.unlocked ? '已获得' : '未获得'}}</text>
      </view>
    </view>

    <view class="badge-info">
      <view class="info-row">
        <text class="info-label">描述</text>
        <text class="info-value">{{badge.description || '暂无描述'}}</text>
      </view>
      <view class="info-row" wx:if="{{badge.pointsRequired !== null && badge.pointsRequired !== undefined}}">
        <text class="info-label">所需积分</text>
        <text class="info-value">{{badge.pointsRequired}}</text>
      </view>
      <view class="info-row" wx:if="{{badge.createdAt}}">
        <text class="info-label">创建时间</text>
        <text class="info-value">{{badge.createdAt}}</text>
      </view>
    </view>
  </view>

  <!-- 未找到 -->
  <view class="empty-wrap" wx:elif="{{!_loading}}">
    <text class="empty-text">未找到该徽章</text>
  </view>
</view>
