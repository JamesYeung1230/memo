.page-scroll {
  flex: 1;
  height: 0;
}

.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--color-bg-page);
}

.content-scroll {
  flex-direction: column;
  gap: 24rpx;
  padding: 0 32rpx 220rpx 32rpx;
}

.points-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 240rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-primary);
  padding: 40rpx;
}

.points-label {
  color: var(--color-text-on-primary);
  font-size: var(--font-caption);
}

.points-amount {
  color: var(--color-text-on-primary);
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.1;
}

.points-hint {
  color: var(--color-primary-light);
  font-size: var(--font-caption);
}

.ad-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  padding: 0 32rpx;
}

.ad-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.ad-icon {
  font-size: 40rpx;
}

.ad-text {
  color: var(--color-text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.ad-btn {
  border-radius: var(--radius-full);
  background-color: var(--color-warning);
  padding: 12rpx 28rpx;
}

.ad-btn-text {
  color: var(--color-text-on-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.section-wrap {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-label {
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
  font-weight: 600;
}

.store-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.store-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 200rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  padding: 24rpx;
}

.store-icon {
  font-size: 48rpx;
}

.store-name {
  color: var(--color-text-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.store-price {
  font-size: 22rpx;
}

.store-price--unlocked {
  color: var(--color-primary);
}

.store-price--locked {
  color: var(--color-error);
}

.ach-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.ach-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 160rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
}

.ach-icon {
  font-size: 48rpx;
}

.ach-name {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.page-enter {
  animation: pageEnter 0.35s ease-out;
}

@keyframes pageEnter {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
