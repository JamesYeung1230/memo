.page-scroll {
  flex: 1;
  height: 100%;
}

.page-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 32rpx 48rpx 32rpx;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 8rpx;
}

.skeleton-card {
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
}

.skeleton-row {
  height: 24rpx;
  border-radius: var(--radius-sm);
  background-color: var(--color-divider);
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 96rpx;
  line-height: 1;
  margin-bottom: var(--space-md);
}

.empty-text {
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  text-align: center;
}

/* ===== 审核记录列表 ===== */
.audit-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-top: 8rpx;
}

.audit-item {
  padding: 28rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
}

.audit-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.audit-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 16rpx;
}

.audit-time {
  display: block;
  font-size: var(--font-tag);
  color: var(--color-text-hint);
  margin-bottom: 12rpx;
}

.audit-content {
  display: block;
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ===== 审核状态标签 ===== */
.audit-status {
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  padding: 4rpx 14rpx;
}

.audit-status--draft {
  background-color: #F3F4F6;
}

.audit-status--pending {
  background-color: #FEF3C7;
}

.audit-status--submitted {
  background-color: #FEF3C7;
}

.audit-status--approved {
  background-color: #DCFCE7;
}

.audit-status--rejected {
  background-color: #FEE2E2;
}

.audit-status-text {
  font-size: var(--font-tag);
  font-weight: 500;
}

.audit-status--draft .audit-status-text {
  color: var(--color-text-hint);
}

.audit-status--pending .audit-status-text {
  color: var(--color-warning);
}

.audit-status--submitted .audit-status-text {
  color: var(--color-warning);
}

.audit-status--approved .audit-status-text {
  color: var(--color-success);
}

.audit-status--rejected .audit-status-text {
  color: var(--color-error);
}

/* ===== 审核备注 ===== */
.audit-remark {
  display: flex;
  flex-direction: row;
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: var(--radius-sm);
  background-color: #FFFBEB;
}

.audit-remark-label {
  font-size: var(--font-tag);
  color: var(--color-warning);
  flex-shrink: 0;
  font-weight: 500;
}

.audit-remark-text {
  font-size: var(--font-tag);
  color: var(--color-text-secondary);
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}
