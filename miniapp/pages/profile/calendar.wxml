<navigation-bar title="打卡日历" back="{{true}}" color="#1E293B" background="#FFF"></navigation-bar>

<view class="page-wrapper">
  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content">

      <!-- 月份切换行 -->
      <view class="month-nav">
        <view class="month-nav-btn" bind:tap="onPrevMonth">
          <text class="month-nav-arrow">‹</text>
        </view>
        <text class="month-nav-title">{{year}}年{{month}}月</text>
        <view class="month-nav-btn" bind:tap="onNextMonth">
          <text class="month-nav-arrow">›</text>
        </view>
      </view>

      <!-- 星期行 -->
      <view class="weekday-row">
        <view class="weekday-cell" wx:for="{{weekLabels}}" wx:key="index">{{item}}</view>
      </view>

      <!-- 日历网格 -->
      <view class="calendar-grid">
        <view
          class="calendar-cell {{item.isEmpty ? 'cell-empty' : ''}} {{item.isToday ? 'cell-today' : ''}}"
          wx:for="{{days}}"
          wx:key="index"
        >
          <view class="cell-inner {{item.isToday ? 'inner-today' : ''}}">
            <text class="cell-day {{item.isEmpty ? 'day-empty' : ''}} {{item.isToday ? 'day-today' : ''}}">{{item.day}}</text>
            <view class="cell-dot {{item.checked ? 'dot-checked' : ''}}"></view>
          </view>
        </view>
      </view>

      <!-- 底部统计 -->
      <view class="stats-section">
        <view class="stats-card">
          <view class="stats-item">
            <text class="stats-number">{{totalDays}}</text>
            <text class="stats-label">本月打卡天数</text>
          </view>
          <view class="stats-divider"></view>
          <view class="stats-item">
            <text class="stats-number stats-number--streak">{{currentStreak}}</text>
            <text class="stats-label">连续打卡天数</text>
          </view>
        </view>
      </view>

      <view class="bottom-safe-area" />
    </view>
  </scroll-view>
</view>
