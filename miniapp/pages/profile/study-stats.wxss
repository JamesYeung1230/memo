.page-scroll {
  flex: 1;
  height: 100%;
}

.page-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 32rpx 48rpx 32rpx;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 8rpx;
}

.skeleton-card {
  padding: 32rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
}

.skeleton-row {
  height: 28rpx;
  border-radius: var(--radius-sm);
  background-color: var(--color-divider);
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ===== 主内容区（卡片间距） ===== */
.main-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 8rpx;
}

/* ===== 概览卡片行 ===== */
.stats-row--three {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  height: 180rpx;
  padding: 24rpx 0;
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
}

.stats-item--icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.stats-icon {
  font-size: 48rpx;
  line-height: 1;
}

.stats-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.stats-value--green {
  color: var(--color-success);
}

.stats-value--amber {
  color: var(--color-warning);
}

.stats-label {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

.stats-divider {
  width: 1rpx;
  height: 80rpx;
  background-color: var(--color-divider);
}

/* ===== 统计卡片 ===== */
.stats-card {
  padding: 24rpx 32rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
}

.stats-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.stats-card-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-primary);
}

.stats-card-count {
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text-secondary);
}

.stats-card-count--primary {
  color: var(--color-primary);
  font-size: var(--font-h2);
}

/* ===== 进度条 ===== */
.progress-track {
  height: 12rpx;
  border-radius: 9999rpx;
  background-color: var(--color-divider);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 9999rpx;
  background-color: var(--color-primary);
  transition: width 0.6s ease-out;
}

.progress-fill--green {
  background-color: var(--color-success);
}

/* ===== 答题统计 ===== */
.quiz-stats-grid {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  padding-top: 8rpx;
}

.quiz-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.quiz-stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.quiz-stat-value--green {
  color: var(--color-success);
}

.quiz-stat-value--red {
  color: var(--color-error);
}

.quiz-stat-label {
  font-size: var(--font-tag);
  color: var(--color-text-hint);
}

/* ===== 操作按钮 ===== */
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-lg);
  cursor: pointer;
}

.action-btn--primary {
  background-color: var(--color-primary);
}

.action-btn--outline {
  border: 2rpx solid var(--color-primary);
  background-color: transparent;
}

.action-btn-text {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-on-primary);
}

.action-btn-text--outline {
  color: var(--color-primary);
}
