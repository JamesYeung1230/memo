<view class="page-wrapper {{_pageEnter ? 'page-enter' : ''}}">
  <navigation-bar title="我的" back="{{false}}" background="#F5F6FA" color="#1E293B" />

  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content">
      <view class="user-card" bind:tap="onUserTap">
        <view class="user-avatar">
          <text class="avatar-text">J</text>
        </view>
        <view class="user-info">
          <text class="user-name">James</text>
          <text class="user-level">编程学习者 · 已坚持 14 天</text>
        </view>
        <text class="profile-arrow">›</text>
      </view>

      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-number stat-number--blue">42</text>
          <text class="stat-label">已掌握</text>
        </view>
        <view class="stat-item">
          <text class="stat-number stat-number--green">68%</text>
          <text class="stat-label">正确率</text>
        </view>
        <view class="stat-item">
          <text class="stat-number stat-number--amber">7天</text>
          <text class="stat-label">连续打卡</text>
        </view>
      </view>

      <view class="menu-section">
        <view class="menu-item" bind:tap="onMenuTap" data-page="study-stats">
          <view class="menu-item-left">
            <text class="menu-icon">📊</text>
            <text class="menu-text">学习统计</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bind:tap="onMenuTap" data-page="favorites">
          <view class="menu-item-left">
            <text class="menu-icon">🔖</text>
            <text class="menu-text">收藏夹</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bind:tap="onMenuTap" data-page="achievements">
          <view class="menu-item-left">
            <text class="menu-icon">🏆</text>
            <text class="menu-text">我的成就</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item no-border" bind:tap="onMenuTap" data-page="audit-history">
          <view class="menu-item-left">
            <text class="menu-icon">📋</text>
            <text class="menu-text">笔记审核记录</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="menu-section" style="margin-top: 24rpx;">
        <view class="menu-item no-border" bind:tap="onSettingsTap">
          <view class="menu-item-left">
            <text class="menu-icon">⚙️</text>
            <text class="menu-text">设置</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <tab-bar />
</view>
