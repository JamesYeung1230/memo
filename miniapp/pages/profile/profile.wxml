<view class="page-wrapper {{_pageEnter ? 'page-enter' : ''}}">
  <nav-bar mode="center" title="我的" />

  <scroll-view class="page-scroll" scroll-y type="list">
    <view class="page-content">
      <view class="user-card" bind:tap="onUserTap">
        <view class="user-avatar">
          <text class="avatar-text">{{avatarText}}</text>
        </view>
        <view class="user-info">
          <text class="user-name">{{userName}}</text>
          <text class="user-level">{{userLevel}}</text>
        </view>
        <text class="profile-arrow">›</text>
      </view>

      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-number stat-number--blue">{{masteredCount}}</text>
          <text class="stat-label">已掌握</text>
        </view>
        <view class="stat-item">
          <text class="stat-number stat-number--green">{{accuracyRate}}</text>
          <text class="stat-label">正确率</text>
        </view>
        <view class="stat-item">
          <text class="stat-number stat-number--amber">{{streakDays}}</text>
          <text class="stat-label">连续打卡</text>
        </view>
      </view>

      <view class="menu-section">
        <view class="menu-item" bind:tap="onMenuTap" data-page="study-stats">
          <view class="menu-item-left">
            <text class="menu-icon">📊</text>
            <text class="menu-text">学习统计</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bind:tap="onMenuTap" data-page="favorites">
          <view class="menu-item-left">
            <text class="menu-icon">🔖</text>
            <text class="menu-text">收藏夹</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item" bind:tap="onMenuTap" data-page="achievements">
          <view class="menu-item-left">
            <text class="menu-icon">🏆</text>
            <text class="menu-text">我的成就</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
        <view class="menu-item no-border" bind:tap="onMenuTap" data-page="audit-history">
          <view class="menu-item-left">
            <text class="menu-icon">📋</text>
            <text class="menu-text">笔记审核记录</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
      </view>

      <view class="bottom-safe-area" />
    </view>
  </scroll-view>
</view>
