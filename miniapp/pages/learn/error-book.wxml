<navigation-bar title="错题本" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="page-wrapper">
  <!-- 加载骨架 -->
  <loading-skeleton wx:if="{{_loading && questions.length === 0}}" count="3" type="card"></loading-skeleton>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{!_loading && questions.length === 0}}"
    icon="✅"
    message="暂无错题，继续保持！"
    actionText="刷新"
    showAction="{{true}}"
    bind:action="onRefresh"
  ></empty-state>

  <!-- 错题列表 -->
  <scroll-view wx:else class="page-scroll" scroll-y type="list" refresher-enabled="{{true}}" refresher-triggered="{{_loading}}" bind:refresherrefresh="onRefresh">
    <view class="error-book-body">

      <!-- 统计头部 -->
      <view class="stats-header">
        <view class="stats-header-left">
          <text class="stats-header-icon">📖</text>
          <view class="stats-header-info">
            <text class="stats-header-title">错题本</text>
            <text class="stats-header-sub">共 {{totalCount}} 道错题</text>
          </view>
        </view>
        <view class="stats-header-right" wx:if="{{questions.length > 0}}">
          <button class="practice-all-btn" bind:tap="onPracticeAll">
            <text class="practice-all-btn-text">全部练习</text>
          </button>
        </view>
      </view>

      <!-- 错题列表 -->
      <view
        wx:for="{{questions}}"
        wx:for-item="item"
        wx:key="id"
        class="question-card"
        data-question-id="{{item.id || item.question_id}}"
        bind:tap="onPracticeTap"
      >
        <view class="question-card-header">
          <view class="question-card-badge">错题</view>
          <view class="question-card-index">#{{index + 1}}</view>
        </view>

        <text class="question-card-text">{{item.question || item.content || ''}}</text>

        <view class="question-card-options" wx:if="{{item.options && item.options.length > 0}}">
          <view
            wx:for="{{item.options}}"
            wx:for-item="opt"
            wx:key="{{index}}"
            class="question-card-option"
          >
            <text class="qco-letter">{{opt.letter || opt.label || ''}}</text>
            <text class="qco-text">{{opt.text || opt.content || ''}}</text>
          </view>
        </view>

        <view class="question-card-footer" wx:if="{{item.wrong_answer || item.correct_answer || item.answer}}">
          <text class="question-card-wrong-label">你的答案：</text>
          <text class="question-card-wrong-value">{{item.wrong_answer || ''}}</text>
          <text class="question-card-correct-label">正确答案：</text>
          <text class="question-card-correct-value">{{item.correct_answer || item.answer || ''}}</text>
        </view>

        <view class="question-card-action">
          <text class="question-card-action-text">重新练习</text>
          <text class="question-card-action-arrow">›</text>
        </view>
      </view>

      <view class="bottom-safe-area" />
    </view>
  </scroll-view>
</view>
