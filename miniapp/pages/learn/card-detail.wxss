.page-scroll {
  flex: 1;
  height: 100%;
}

.page-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: 0 var(--space-lg) var(--space-xl) var(--space-lg);
}

.card-detail-wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

/* 类比区域 */
.analogy-section {
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.section-label {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-xs);
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  color: var(--color-text-primary);
  font-size: var(--font-h2);
  font-weight: 600;
}

.analogy-content {
  background-color: var(--color-bg-page);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  border-left: 6rpx solid var(--color-primary);
}

.analogy-text {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: 1.7;
}

/* 分享区域 */
.share-section {
  display: flex;
  flex-direction: row;
  justify-content: center;
  padding: var(--space-md) 0;
}

.share-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md) var(--space-xl);
  border-radius: var(--radius-full);
  background-color: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--color-divider);
}

.share-btn:active {
  opacity: 0.7;
  transform: scale(0.97);
}

.share-btn-icon {
  font-size: 36rpx;
}

.share-btn-text {
  color: var(--color-text-primary);
  font-size: var(--font-body);
  font-weight: 500;
}

/* 隐藏 canvas */
#share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 600rpx;
  height: 800rpx;
}

.bottom-safe {
  height: 48rpx;
}
