.page-scroll {
  flex: 1;
  height: 100%;
}

.page-content {
  padding: var(--space-md);
}

/* ===== 统计头部 ===== */
.notes-header {
  margin-bottom: var(--space-md);
}

.notes-header-count {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
}

/* ===== 笔记列表 ===== */
.notes-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding-bottom: var(--space-xl);
}

/* ===== 笔记卡片 ===== */
.note-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  display: flex;
  flex-direction: column;
}

.note-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-sm);
}

.note-card-title {
  font-size: var(--font-body-bold);
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-card-arrow {
  font-size: var(--font-h2);
  color: var(--color-text-hint);
  margin-left: var(--space-sm);
}

/* 内容摘要 */
.note-card-content {
  margin-bottom: var(--space-sm);
}

.note-card-summary {
  font-size: var(--font-body);
  color: var(--color-text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 我的笔记（高亮气泡） */
.note-card-mynote {
  margin-bottom: var(--space-sm);
}

.note-card-mynote-label {
  font-size: var(--font-tag);
  color: var(--color-primary);
  font-weight: 600;
  display: block;
  margin-bottom: var(--space-xs);
}

.note-card-mynote-bubble {
  background: var(--color-bg-page);
  border-left: 4rpx solid var(--color-primary-light);
  border-radius: var(--radius-sm);
  padding: var(--space-sm) var(--space-md);
}

.note-card-mynote-text {
  font-size: var(--font-body);
  color: var(--color-text-primary);
  line-height: 1.6;
}

/* 标签 */
.note-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}

.note-card-tag {
  font-size: var(--font-tag);
  color: var(--color-primary);
  background: var(--color-bg-page);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

/* 底部 */
.note-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: var(--space-sm);
  padding-top: var(--space-sm);
  border-top: 1px solid var(--color-divider);
}

.note-card-next {
  font-size: var(--font-caption);
  color: var(--color-text-hint);
}

.note-card-review-btn {
  background: var(--color-primary);
  border-radius: var(--radius-full);
  padding: var(--space-xs) var(--space-md);
}

.note-card-review-btn-text {
  font-size: var(--font-caption);
  color: var(--color-text-on-primary);
  font-weight: 500;
}
