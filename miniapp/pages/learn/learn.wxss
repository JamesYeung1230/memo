.page-scroll {
  flex: 1;
  height: 100%;
}

.page-wrapper {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

.nav-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
  background-color: var(--color-bg-page);
}

.nav-title {
  color: var(--color-text-primary);
  font-size: 34rpx;
  font-weight: 600;
}

.nav-search-icon {
  color: var(--color-text-primary);
  font-size: 36rpx;
}

.content-scroll {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 32rpx 48rpx 32rpx;
}

.domain-tags {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  overflow-x: auto;
}

.tag {
  border-radius: 9999rpx;
  background-color: var(--color-bg-card);
  padding: 12rpx 24rpx;
  flex-shrink: 0;
}

.tag--active {
  background-color: var(--color-primary);
}

.tag-text {
  color: var(--color-text-secondary);
  font-size: 24rpx;
  font-weight: normal;
}

.tag-text--active {
  color: var(--color-text-on-primary);
  font-weight: 600;
}

.overview-card {
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.overview-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.overview-title {
  color: var(--color-text-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.overview-status {
  color: var(--color-primary);
  font-size: 24rpx;
}

.progress-bar {
  height: 12rpx;
  border-radius: 6rpx;
  background-color: var(--color-divider);
  overflow: hidden;
}

.progress-bar-fill {
  height: 12rpx;
  border-radius: 6rpx;
  background-color: var(--color-primary);
}

.stats-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.stat-num {
  color: var(--color-text-primary);
  font-size: 36rpx;
  font-weight: 700;
}

.stat-label {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

.entry-card {
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  height: 144rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
}

.entry-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.entry-icon {
  font-size: 48rpx;
}

.entry-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.entry-title {
  color: var(--color-text-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.entry-sub {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.entry-arrow {
  color: var(--color-text-hint);
  font-size: 40rpx;
}

.memory-card {
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.memory-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.memory-title {
  color: var(--color-text-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.memory-subtitle {
  color: var(--color-text-hint);
  font-size: 22rpx;
}

.memory-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
}

.memory-item-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.memory-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.dot--blue {
  background-color: var(--color-primary);
}

.dot--red {
  background-color: var(--color-error);
}

.dot--gray {
  background-color: var(--color-text-hint);
}

.memory-item-text {
  color: var(--color-text-primary);
  font-size: 28rpx;
}

.memory-item-arrow {
  color: var(--color-text-hint);
  font-size: 32rpx;
}

.bottom-safe-area {
  height: calc(env(safe-area-inset-bottom));
}

.page-enter {
  animation: pageEnter 0.35s ease-out;
}

@keyframes pageEnter {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
