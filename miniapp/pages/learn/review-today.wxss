.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--color-bg-page);
  overflow: hidden;
}

.page-scroll {
  flex: 1;
  min-height: 0;
}

.review-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-lg);
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

/* ========== 进度概览 ========== */
.progress-overview {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.progress-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.progress-title {
  color: var(--color-text-primary);
  font-size: var(--font-h2);
  font-weight: 600;
}

.progress-percent {
  color: var(--color-primary);
  font-size: var(--font-h1);
  font-weight: 700;
}

.progress-bar-track {
  height: 12rpx;
  border-radius: 6rpx;
  background-color: var(--color-divider);
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  background-color: var(--color-primary);
  transition: width 0.3s;
}

.progress-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.progress-info-text {
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.progress-info-sub {
  color: var(--color-text-hint);
  font-size: var(--font-caption);
}

/* ========== 复习卡片 ========== */
.review-card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  box-shadow: var(--shadow-sm);
}

.review-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.review-card-title {
  flex: 1;
  color: var(--color-text-primary);
  font-size: var(--font-h2);
  font-weight: 600;
  line-height: 1.4;
}

.review-card-status {
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  margin-left: var(--space-sm);
  flex-shrink: 0;
}

.review-card-status--done {
  background-color: rgba(34, 197, 94, 0.1);
}

.review-card-status--pending {
  background-color: rgba(249, 168, 37, 0.1);
}

.review-card-status-text {
  font-size: 20rpx;
  font-weight: 600;
}

.review-card-status--done .review-card-status-text {
  color: var(--color-success);
}

.review-card-status--pending .review-card-status-text {
  color: var(--color-warning);
}

.review-card-concept {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: 1.5;
}

.review-card-footer {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-xs);
}

.review-card-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  flex: 1;
}

.review-card-tag {
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  background-color: var(--color-bg-page);
  color: var(--color-text-hint);
  font-size: 20rpx;
}

.review-card-difficulty {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: var(--space-sm);
}

.difficulty-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.difficulty-dot--easy {
  background-color: var(--color-success);
}

.difficulty-dot--medium {
  background-color: var(--color-warning);
}

.difficulty-dot--hard {
  background-color: var(--color-error);
}

.difficulty-text {
  color: var(--color-text-hint);
  font-size: 20rpx;
}

/* ========== 完成按钮 ========== */
.review-card-action {
  margin-top: var(--space-xs);
}

.complete-btn {
  width: 100%;
  height: 72rpx;
  border-radius: var(--radius-md);
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.9;
}

.complete-btn--done {
  background-color: var(--color-divider);
}

.complete-btn-text {
  color: var(--color-text-on-primary);
  font-size: var(--font-body);
  font-weight: 600;
}

.complete-btn--done .complete-btn-text {
  color: var(--color-text-hint);
}
