.page-wrapper {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

.page-scroll {
  flex: 1;
  height: 100%;
}

/* ========== 答题内容 ========== */
.quiz-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.quiz-progress {
  padding: var(--space-md) var(--space-lg);
  background-color: var(--color-bg-card);
}

.quiz-progress-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-sm);
}

.quiz-progress-text {
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.quiz-correct-text {
  color: var(--color-success);
  font-size: var(--font-caption);
  font-weight: 600;
}

.quiz-scroll {
  flex: 1;
}

.quiz-body {
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding-bottom: 200rpx;
}

.quiz-question {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-sm);
}

.question-label {
  display: block;
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.question-text {
  color: var(--color-text-primary);
  font-size: var(--font-h1);
  line-height: 1.6;
  font-weight: 500;
}

/* ========== 选项 ========== */
.quiz-options {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.quiz-option-item {
  display: flex;
  flex-direction: column;
}

.option-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md) var(--space-lg);
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-divider);
}

.option-btn--selected {
  border-color: var(--color-primary);
}

.option-btn--correct {
  border-color: var(--color-success);
  background-color: rgba(34, 197, 94, 0.06);
}

.option-btn--wrong {
  border-color: var(--color-error);
  background-color: rgba(239, 68, 68, 0.06);
}

.option-letter {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background-color: var(--color-bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.option-letter--correct {
  background-color: var(--color-success);
}

.option-letter--wrong {
  background-color: var(--color-error);
}

.option-letter-text {
  color: var(--color-text-secondary);
  font-size: var(--font-body-bold);
  font-weight: 600;
}

.option-letter--correct .option-letter-text,
.option-letter--wrong .option-letter-text {
  color: #fff;
}

.option-text {
  flex: 1;
  color: var(--color-text-primary);
  font-size: var(--font-body);
  line-height: 1.5;
}

.option-icon {
  font-size: 32rpx;
  font-weight: bold;
  flex-shrink: 0;
  margin-left: auto;
}

.option-btn--correct .option-icon {
  color: var(--color-success);
}

.option-btn--wrong .option-icon {
  color: var(--color-error);
}

/* ========== 反馈 ========== */
.quiz-feedback {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.feedback-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md) var(--space-lg);
  border-radius: var(--radius-md);
}

.feedback-banner--correct {
  background-color: rgba(34, 197, 94, 0.1);
  border: 1rpx solid var(--color-success);
}

.feedback-banner--wrong {
  background-color: rgba(239, 68, 68, 0.1);
  border: 1rpx solid var(--color-error);
}

.feedback-icon {
  font-size: 36rpx;
  font-weight: bold;
}

.feedback-banner--correct .feedback-icon {
  color: var(--color-success);
}

.feedback-banner--wrong .feedback-icon {
  color: var(--color-error);
}

.feedback-text {
  font-size: var(--font-body-bold);
  font-weight: 600;
}

.feedback-banner--correct .feedback-text {
  color: var(--color-success);
}

.feedback-banner--wrong .feedback-text {
  color: var(--color-error);
}

.feedback-answer {
  padding: var(--space-md);
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: row;
  gap: var(--space-xs);
}

.feedback-answer-label {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}

.feedback-answer-text {
  color: var(--color-primary);
  font-size: var(--font-body);
  font-weight: 600;
}

.feedback-explanation {
  padding: var(--space-md);
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  border-left: 6rpx solid var(--color-primary);
}

.feedback-explanation-label {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 600;
  display: block;
  margin-bottom: var(--space-xs);
}

.feedback-explanation-text {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: 1.6;
}

/* ========== 底部 ========== */
.quiz-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background-color: var(--color-bg-card);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.next-btn {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.next-btn--active {
  background-color: var(--color-primary);
}

.next-btn-text {
  color: var(--color-text-on-primary);
  font-size: var(--font-h1);
  font-weight: 600;
}

.next-btn:not(.next-btn--active) .next-btn-text {
  color: var(--color-text-hint);
}

/* ========== 结果页 ========== */
.result-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-lg);
}

.result-card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: var(--space-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-md);
  width: 100%;
  max-width: 500rpx;
}

.result-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: var(--color-bg-page);
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-icon {
  font-size: 64rpx;
}

.result-title {
  color: var(--color-text-primary);
  font-size: var(--font-h1);
  font-weight: 600;
}

.result-stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-lg);
  padding: var(--space-md) 0;
}

.result-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.result-stat-num {
  font-size: 40rpx;
  font-weight: 700;
}

.result-stat-num--correct {
  color: var(--color-success);
}

.result-stat-num--wrong {
  color: var(--color-error);
}

.result-stat-num--total {
  color: var(--color-text-primary);
}

.result-stat-label {
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.result-stat-divider {
  width: 2rpx;
  height: 48rpx;
  background-color: var(--color-divider);
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  width: 100%;
  margin-top: var(--space-sm);
}

.retry-btn {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
}

.retry-btn::after {
  border: none;
}

.retry-btn-text {
  color: var(--color-text-on-primary);
  font-size: var(--font-h1);
  font-weight: 600;
}

.back-btn {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background-color: transparent;
  border: 2rpx solid var(--color-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.back-btn::after {
  border: none;
}

.back-btn-text {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}
