.page-scroll {
  flex: 1;
  height: 100%;
}

.page-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: 0 var(--space-lg) var(--space-lg) var(--space-lg);
}

.search-section {
  padding: var(--space-md) 0;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.card-item {
  border-radius: var(--radius-lg);
  background-color: var(--color-bg-card);
  box-shadow: var(--shadow-sm);
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  transition: transform 0.15s;
}

.card-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.card-top-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-sm);
}

.card-title {
  color: var(--color-text-primary);
  font-size: var(--font-h1);
  font-weight: 600;
  flex: 1;
  line-height: 1.4;
}

.card-status-badges {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-xs);
  flex-shrink: 0;
}

.card-concept {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--space-xs);
}

.tag-card-item {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background-color: var(--color-primary-light);
  border: 1rpx solid rgba(74, 144, 217, 0.15);
}

.tag-card-text {
  font-size: 20rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.card-bottom-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-top: var(--space-xs);
}

.card-difficulty {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-xs);
}

.difficulty-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.difficulty-dot--easy {
  background-color: var(--color-success);
}

.difficulty-dot--medium {
  background-color: var(--color-warning);
}

.difficulty-dot--hard {
  background-color: var(--color-error);
}

.difficulty-text {
  color: var(--color-text-hint);
  font-size: var(--font-caption);
}

.card-mastered-badge {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  background-color: rgba(34, 197, 94, 0.1);
  color: var(--color-success);
  font-size: var(--font-tag);
  font-weight: 500;
}

.card-fav-icon {
  font-size: 32rpx;
}

.card-fav-icon--active {
  color: var(--color-warning);
}

.search-count {
  color: var(--color-text-hint);
  font-size: var(--font-caption);
  padding: 0 var(--space-lg);
}

.bottom-safe {
  height: 168rpx;
}
