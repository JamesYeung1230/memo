.page-scroll {
  flex: 1;
  height: 100%;
}

.page-wrapper {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--color-bg-page);
}

.quiz-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.quiz-progress {
  padding: var(--space-md) var(--space-lg);
  background-color: var(--color-bg-card);
}

.quiz-progress-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-sm);
}

.quiz-progress-text {
  color: var(--color-text-secondary);
  font-size: var(--font-caption);
}

.quiz-correct-text {
  color: var(--color-success);
  font-size: var(--font-caption);
  font-weight: 600;
}

.quiz-scroll {
  flex: 1;
}

.quiz-body {
  padding: var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding-bottom: 200rpx;
}

.quiz-question {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--shadow-sm);
}

.question-label {
  display: block;
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.question-text {
  color: var(--color-text-primary);
  font-size: var(--font-h1);
  line-height: 1.6;
  font-weight: 500;
}

.quiz-options {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.quiz-option-item {
  display: flex;
  flex-direction: column;
}

.quiz-feedback {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
}

.feedback-banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-md) var(--space-lg);
  border-radius: var(--radius-md);
}

.feedback-banner--correct {
  background-color: rgba(34, 197, 94, 0.1);
  border: 1rpx solid var(--color-success);
}

.feedback-banner--wrong {
  background-color: rgba(239, 68, 68, 0.1);
  border: 1rpx solid var(--color-error);
}

.feedback-icon {
  font-size: 36rpx;
  font-weight: bold;
}

.feedback-banner--correct .feedback-icon {
  color: var(--color-success);
}

.feedback-banner--wrong .feedback-icon {
  color: var(--color-error);
}

.feedback-text {
  font-size: var(--font-body-bold);
  font-weight: 600;
}

.feedback-banner--correct .feedback-text {
  color: var(--color-success);
}

.feedback-banner--wrong .feedback-text {
  color: var(--color-error);
}

.feedback-answer {
  padding: var(--space-md);
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: row;
  gap: var(--space-xs);
}

.feedback-answer-label {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
}

.feedback-answer-text {
  color: var(--color-primary);
  font-size: var(--font-body);
  font-weight: 600;
}

.feedback-explanation {
  padding: var(--space-md);
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  border-left: 6rpx solid var(--color-primary);
}

.feedback-explanation-label {
  color: var(--color-primary);
  font-size: var(--font-caption);
  font-weight: 600;
  display: block;
  margin-bottom: var(--space-xs);
}

.feedback-explanation-text {
  color: var(--color-text-secondary);
  font-size: var(--font-body);
  line-height: 1.6;
}

.quiz-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background-color: var(--color-bg-card);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.next-btn {
  width: 100%;
  height: 88rpx;
  border-radius: var(--radius-lg);
  background-color: var(--color-divider);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.next-btn--active {
  background-color: var(--color-primary);
}

.next-btn-text {
  color: var(--color-text-on-primary);
  font-size: var(--font-h1);
  font-weight: 600;
}

.next-btn:not(.next-btn--active) .next-btn-text {
  color: var(--color-text-hint);
}
