<navigation-bar title="答题练习" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="page-wrapper">

  <!-- 加载骨架 -->
  <loading-skeleton wx:if="{{_loading}}" count="3" type="card"></loading-skeleton>

  <!-- 空状态 -->
  <empty-state
    wx:elif="{{!_loading && questions.length === 0}}"
    icon="📝"
    message="暂无答题题目"
    actionText="重试"
    showAction="{{true}}"
    bind:action="fetchQuestions"
  ></empty-state>

  <!-- 答题内容 -->
  <view wx:else class="quiz-content">

    <!-- 顶部进度 -->
    <view class="quiz-progress">
      <progress-bar
        percent="{{totalQuestions > 0 ? (currentIndex / totalQuestions) * 100 : 0}}"
        height="8"
        color="var(--color-primary)"
      ></progress-bar>
      <view class="quiz-progress-info">
        <text class="quiz-progress-text">第 {{currentIndex + 1}} / {{totalQuestions}} 题</text>
        <text class="quiz-correct-text">正确 {{correctCount}} 题</text>
      </view>
    </view>

    <!-- 题目区域 -->
    <scroll-view class="quiz-scroll" scroll-y type="list">
      <view class="quiz-body">

        <!-- 题目内容 -->
        <view class="quiz-question" wx:if="{{questions[currentIndex]}}">
          <text class="question-label">题目</text>
          <text class="question-text">{{questions[currentIndex].question_text || questions[currentIndex].question || questions[currentIndex].content || ''}}</text>
        </view>

        <!-- 选项列表 -->
        <view class="quiz-options" wx:if="{{currentQuestionOptions}}">
          <view
            wx:for="{{currentQuestionOptions}}"
            wx:for-item="opt"
            wx:key="letter"
            class="quiz-option-item"
          >
            <quiz-option
              letter="{{opt.letter}}"
              text="{{opt.text}}"
              selected="{{opt.selected}}"
              status="{{opt.status}}"
              showExplanation="{{opt.showExplanation}}"
              explanation="{{explanation}}"
              bind:select="onOptionSelect"
            ></quiz-option>
          </view>
        </view>

        <!-- 反馈区域 -->
        <view class="quiz-feedback" wx:if="{{isAnswered}}">
          <view class="feedback-banner {{isCorrect ? 'feedback-banner--correct' : 'feedback-banner--wrong'}}">
            <text class="feedback-icon">{{isCorrect ? '✓' : '✗'}}</text>
            <text class="feedback-text">{{isCorrect ? '回答正确！' : '回答错误'}}</text>
          </view>
          <view class="feedback-answer" wx:if="{{!isCorrect && correctAnswer}}">
            <text class="feedback-answer-label">正确答案：</text>
            <text class="feedback-answer-text">{{correctAnswer}}</text>
          </view>
          <view class="feedback-explanation" wx:if="{{explanation}}">
            <text class="feedback-explanation-label">解析：</text>
            <text class="feedback-explanation-text">{{explanation}}</text>
          </view>
        </view>

      </view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="quiz-footer">
      <view
        class="next-btn {{isAnswered ? 'next-btn--active' : ''}}"
        bind:tap="onNext"
      >
        <view class="next-btn-text">
          {{currentIndex + 1 >= totalQuestions ? '查看结果' : '下一题'}}
        </view>
      </view>
    </view>

  </view>

</view>
