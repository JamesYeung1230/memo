<view class="progress-bar">
  <view class="progress-bar__track" style="height: {{height}}rpx; border-radius: {{height / 2}}rpx;">
    <view
      class="progress-bar__fill"
      style="height: {{height}}rpx; width: {{displayPercent}}%; background-color: {{color || (displayPercent >= 100 ? 'var(--color-success)' : 'var(--color-primary)')}}; border-radius: {{height / 2}}rpx;"
    ></view>
  </view>
  <text wx:if="{{showText}}" class="progress-bar__text">{{displayPercent}}%</text>
</view>
