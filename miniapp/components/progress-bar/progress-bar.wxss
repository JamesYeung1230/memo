.progress-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.progress-bar__track {
  flex: 1;
  background-color: var(--color-divider);
  overflow: hidden;
}

.progress-bar__fill {
  transition: width 0.6s ease-out;
  will-change: width;
}

.progress-bar__text {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  margin-left: var(--space-sm);
  min-width: 72rpx;
  text-align: right;
  flex-shrink: 0;
}
