.search-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
}

.search-bar__input-wrap {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 72rpx;
  background-color: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 0 var(--space-md);
}

.search-bar__icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: var(--space-sm);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-body);
  line-height: 1;
}

.search-bar__input {
  flex: 1;
  height: 100%;
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.search-bar__input-placeholder {
  color: var(--color-text-hint);
}

.search-bar__clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: var(--space-xs);
  position: relative;
}

.search-bar__clear-x {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 3rpx;
  background-color: var(--color-text-hint);
  border-radius: 2rpx;
}

.search-bar__clear-x--a {
  transform: translate(-50%, -50%) rotate(45deg);
}

.search-bar__clear-x--b {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.search-bar__cancel {
  flex-shrink: 0;
  margin-left: var(--space-md);
  font-size: var(--font-body);
  color: var(--color-primary);
  line-height: 72rpx;
}

.search-bar__cancel--hidden {
  display: none;
}
