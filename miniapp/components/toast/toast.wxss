.toast {
  position: fixed;
  top: 80rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2000;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: 20rpx var(--space-lg);
  border-radius: var(--radius-md);
  background-color: var(--toast-bg);
  box-sizing: border-box;
  max-width: 640rpx;
}

.toast--enter {
  animation: toastSlideIn 200ms ease-out forwards;
}

@keyframes toastSlideIn {
  from {
    opacity: 0;
    transform: translateX(-50%) translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
}

.toast-icon {
  font-size: var(--font-body);
  line-height: 1;
  color: var(--toast-fg);
  flex-shrink: 0;
}

.toast-message {
  font-size: var(--font-caption);
  color: var(--color-text-primary);
  line-height: 1.5;
  word-break: break-all;
}
