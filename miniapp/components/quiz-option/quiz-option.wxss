.qopt {
  width: 100%;
  min-height: 88rpx;
  border-radius: var(--radius-md);
  border: 2rpx solid var(--color-divider);
  background-color: var(--color-bg-card);
  padding: var(--space-sm) var(--space-md);
  display: flex;
  flex-direction: row;
  align-items: center;
  transition: border-color 0.2s, background-color 0.2s;
}

.qopt--default {
  border-color: var(--color-divider);
  background-color: var(--color-bg-card);
}

.qopt--selected {
  border-color: var(--color-primary);
  background-color: rgba(74, 144, 217, 0.08);
}

.qopt--correct {
  border-color: var(--color-success);
  background-color: rgba(34, 197, 94, 0.08);
}

.qopt--wrong {
  border-color: var(--color-error);
  background-color: rgba(239, 68, 68, 0.08);
}

.qopt__letter {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: var(--space-sm);
  flex-shrink: 0;
  background-color: var(--color-bg-page);
}

.qopt__letter-text {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-hint);
}

.qopt--selected .qopt__letter {
  background-color: var(--color-primary-light);
}

.qopt--selected .qopt__letter-text {
  color: var(--color-primary-dark);
}

.qopt--correct .qopt__letter {
  background-color: rgba(34, 197, 94, 0.15);
}

.qopt--correct .qopt__letter-text {
  color: var(--color-success);
}

.qopt--wrong .qopt__letter {
  background-color: rgba(239, 68, 68, 0.15);
}

.qopt--wrong .qopt__letter-text {
  color: var(--color-error);
}

.qopt__text {
  flex: 1;
  font-size: var(--font-body);
  color: var(--color-text-primary);
}

.qopt__icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: var(--space-sm);
  flex-shrink: 0;
}

.qopt__icon-text {
  font-size: var(--font-body);
  font-weight: 700;
}

.qopt--correct .qopt__icon-text {
  color: var(--color-success);
}

.qopt--wrong .qopt__icon-text {
  color: var(--color-error);
}

.qopt__explanation {
  margin-top: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  background-color: var(--color-bg-page);
  border-radius: var(--radius-sm);
}

.qopt__explanation-text {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.6;
}
