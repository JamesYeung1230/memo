.swipe-action {
  position: relative;
  overflow: hidden;
}

.swipe-action__actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
}

.swipe-action__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 100%;
  font-size: var(--font-body);
  color: var(--color-text-on-primary);
}

.swipe-action__btn--edit {
  background-color: var(--color-primary);
}

.swipe-action__btn--delete {
  background-color: var(--color-error);
}

.swipe-action__btn--default {
  background-color: var(--color-text-hint);
}

.swipe-action__content {
  position: relative;
  background-color: var(--color-bg-card);
  z-index: 1;
}
