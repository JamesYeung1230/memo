<view class="empty-state">
  <view class="empty-state__icon">{{icon}}</view>
  <text class="empty-state__message">{{message}}</text>
  <view wx:if="{{showAction && actionText}}" class="empty-state__action" bind:tap="onAction">
    <text class="empty-state__action-text">{{actionText}}</text>
  </view>
</view>
