# ============================================================
# 码上启航后端 — 环境变量模板
# 复制本文件为 .env 后填入实际值
# cp .env.example .env
#
# 完整文档见：docs/06-环境变量清单.md
# ============================================================

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# PostgreSQL — 三服务共享同一实例，通过 search_path 隔离 Schema
# DATABASE_URL 由 shared/config.py 自动组合，无需手动设置
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres                # Docker Compose: postgres | 本地开发: localhost
DB_PORT=5432
DB_NAME=codesail

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Redis — 缓存 + 敏感词 + 限流计数 + arq 任务队列
# REDIS_URL 由 shared/config.py 自动组合，无需手动设置
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
REDIS_HOST=redis                # Docker Compose: redis | 本地开发: localhost
REDIS_PORT=6379
REDIS_PASSWORD=                  # 生产环境建议设置

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# JWT — Auth 签发 + Core 本地验签
# 生产环境 JWT_SECRET 必须使用强随机字符串:
#   openssl rand -hex 64
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE=86400          # Access Token 有效期，单位:秒 (默认 24h，范围: 3600~604800)
JWT_REFRESH_EXPIRE=604800        # Refresh Token 有效期，单位:秒 (默认 7d，范围: 86400~2592000)

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# 管理员预设 — 启动时种子数据写入 auth.admin 表
# Docker 环境下 entrypoint 会自动生成（密码 admin123），无需手动设置。
# 如需自定义密码，通过下方变量指定：
#   python -c "import bcrypt; print(bcrypt.hashpw(b'admin123', bcrypt.gensalt(rounds=12)).decode())"
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=             # 可选，Docker 环境自动生成 bcrypt(admin123)

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# 微信小程序 — 在微信公众平台获取
# https://mp.weixin.qq.com/ → 开发管理 → 开发设置
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
WX_APPID=your-wechat-app-id
WX_SECRET=your-wechat-app-secret
WX_MOCK_MODE=true               # true=跳过微信 API，使用 mock openid；false=真实调用

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# DeepSeek API — AI 卡片生成 + 题目生成 + 笔记审核
# https://platform.deepseek.com/ 获取 API Key
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MOCK_MODE=false               # true=使用 MockProvider(不消耗 API 额度)，false=真实调用

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Core 服务 — 内部服务地址
# Docker Compose 内使用服务名; 本地开发改为 http://localhost:8002
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
KNOWLEDGE_SERVICE_URL=http://knowledge:8002

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Core 服务 — 文件上传存储路径
# Docker 环境由 named volume 挂载 (docker-compose.yml 已配置)
# 本地开发可改为 ./uploads
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
UPLOAD_DIR=/data/uploads
